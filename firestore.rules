rules_version = '2';
// Règles de sécurité de la base Firestore.
// Seuls les comptes dont le code (UID) figure ci-dessous peuvent lire et modifier les données.
// L'UID de chaque compte se trouve dans la console Firebase : Authentication → Users, colonne « UID utilisateur ».
// Pour ajouter ou retirer une personne : modifiez la liste puis cliquez sur « Publier » dans la console Firebase.
service cloud.firestore {
  match /databases/{database}/documents {
    function autorise() {
      return request.auth != null
        && request.auth.uid in [
          '7I9eMg64YmdX6hV3KQvoSgo0Djx1',
          'RR7EIKuPdJbHlohRCJsOd6cyddr1'
        ];
    }
    match /{document=**} {
      allow read, write: if autorise();
    }
  }
}
